  "cards": [
    {
      "dot": "emerald",
      "title": "共用骨架（两模式一致）",
      "items": [
        "同一 Agent 调查循环：模型在 6 个只读工具间自主选择，循环至给出终态",
        "预算 8 请求 / 8 工具 / 2 输出重试 / 300s；工具受场景 allowlist 约束",
        "user_prompt 只给 run_id + incident_brief + runtime，不含 Ground Truth",
        "超时 / 超预算 / 协议错都落到 MODEL_ERROR 终态；任何跑过的诊断必产出六文件"
      ]
    },
    {
      "dot": "amber",
      "title": "Static Skill：模型当作者",
      "items": [
        "适配器薄守卫 prepare/accept：只查 预算 / 去重 / 参数形状 / run 范围，不维护假设台账",
        "模型直接输出 _StaticDecision（=Diagnosis）",
        "终态门仅校验引用的 evidence_id 真实存在 + run_id 匹配，无强制弃权"
      ]
    },
    {
      "dot": "violet",
      "title": "Diagnostic Kernel：模型申报，内核裁决（[K] 标记）",
      "items": [
        "prepare_tool：每次工具调用绑 intent（新 gap_id + 假设），参数溯源到 allowlist / 已接受证据",
        "record_tool_result：关闭 gap、登记证据；内核每轮回注 InvestigationState ledger（假设/缺口/provable_relations/剩余预算）",
        "finalize 合同门：≥2 假设 + 支持/反驳 + claim 绑证据 + 缺口关闭或显式弃权",
        "内核只验证 / 拒绝 / 投影，从不替模型生成答案；另存 KERNEL_STATE 终态事件"
      ]
    }
  ]
}
